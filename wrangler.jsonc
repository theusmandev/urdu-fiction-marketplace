{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unb-premium",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "unb-premium-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "unb-premium-tag-cache",
      "database_id": "ab3532e1-c979-43ad-999a-bb7bbaa5a34d"
    }
  ],
  "observability": {
    "enabled": true
  }
}

