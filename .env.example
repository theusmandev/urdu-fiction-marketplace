# ==============================================================================
# UNB Premium — Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to Git.
# NEVER prefix backend secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth & Primary Storage) [REQUIRED]
# Found in: Supabase Dashboard -> Project Settings -> API
# Storage Buckets used:
#   - 'payment-proofs' (PRIVATE bucket for reader TID receipts & fee proofs)
#   - 'novel-assets' / 'novel-covers' (PUBLIC bucket for book covers and author avatars)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-Role Key:
# [SERVER-ONLY] — Strictly NOT used in browser or standard server actions.
# Used exclusively by server-side background cron jobs (src/lib/supabase/cron-client.ts)
# to claim pending outbox emails and process scheduled reminders.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Application Base URL [REQUIRED]
# Used for email confirmation redirects, sitemap, metadata, and canonical URL generation.
# Production: https://premium.urdunovelbanks.com
# Development: http://localhost:3000
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://premium.urdunovelbanks.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Scheduled Worker & Cron Authentication [REQUIRED FOR CRON]
# Secret bearer token used to authenticate automated calls to:
#   - POST /api/cron/send-emails
#   - POST /api/cron/reminders
#   - POST /api/cron/purge-drafts
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
CRON_SECRET=your-32-character-random-cron-secret-token

# ------------------------------------------------------------------------------
# 4. Outbox Transactional HTTP REST Email Delivery [REQUIRED IN PROD, OPTIONAL IN DEV]
# Zero TCP socket dependencies — native to Edge & Cloudflare Workers (workerd).
# Supported providers: "resend" or "brevo".
# If omitted or unconfigured, emails run in safe simulated dry-run mode.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM="UNB Premium <notifications@premium.urdunovelbanks.com>"

# ------------------------------------------------------------------------------
# 5. Cloudflare CDN Edge Cache Purge [OPTIONAL — FOR INSTANT GLOBAL PURGE]
# Powers instant global CDN cache invalidation when site appearance palettes
# or novels are published/updated via revalidateTag and revalidatePath.
# If omitted, edge caching operates gracefully in 2-minute TTL revalidation mode.
# ------------------------------------------------------------------------------
CACHE_PURGE_ZONE_ID=your-cloudflare-zone-id
CACHE_PURGE_API_TOKEN=your-cloudflare-cache-purge-api-token
