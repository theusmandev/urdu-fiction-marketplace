# ==============================================================================
# UNB Premium — Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to Git.
# NEVER prefix backend secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth & Primary Storage) [REQUIRED]
# Found in: Supabase Dashboard -> Project Settings -> API
# Storage Buckets used:
#   - 'payment-proofs' (PRIVATE bucket for reader TID receipts & commission proofs)
#   - 'novel-assets' (PUBLIC bucket for book covers and author avatars)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-Role Key:
# [SERVER-ONLY] — Strictly NOT used in browser or standard server actions.
# Used exclusively by server-side background cron jobs (src/lib/supabase/cron-client.ts)
# to claim pending outbox emails and process scheduled reminders.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Application Base URL [REQUIRED]
# Used for email confirmation redirects and canonical URL generation.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Scheduled Worker & Cron Authentication [REQUIRED FOR CRON]
# Secret bearer token used to authenticate automated calls to:
#   - POST /api/cron/send-emails
#   - POST /api/cron/reminders
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
CRON_SECRET=your-32-character-random-cron-secret-token

# ------------------------------------------------------------------------------
# 4. Outbox Transactional SMTP Delivery (Step 5.2) [OPTIONAL IN DEV, REQUIRED IN PROD]
# Configure SMTP credentials for automated outbox dispatch via nodemailer.
# If omitted or unconfigured, emails run in safe simulated dry-run mode.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_SECURE=false
EMAIL_FROM="UNB Premium <noreply@unbpremium.pk>"

# ------------------------------------------------------------------------------
# 5. Cloudinary (DO NOT USE)
# Supabase Storage is the authoritative storage engine for UNB Premium.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

