# ==============================================================================
# UNB Premium — Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to Git.
# NEVER prefix backend secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth & Primary Storage) [REQUIRED]
# Found in: Supabase Dashboard -> Project Settings -> API
# Storage Buckets used:
#   - 'payment-proofs' (PRIVATE bucket for reader TID receipts & commission proofs)
#   - 'novel-assets' (PUBLIC bucket for book covers and author avatars)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-Role Key:
# [NOT USED YET] — Strictly not used in Step 1.3. All browser and server actions
# operate via user JWT and security-definer RPCs. Reserved only for future offline maintenance/cron scripts.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Application Base URL [REQUIRED]
# Used for email confirmation redirects and canonical URL generation.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Cloudinary (DO NOT USE IN STEP 1.3)
# Supabase Storage is the authoritative storage engine for UNB Premium.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
